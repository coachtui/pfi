# Copy to .env.local and fill in. Validated at startup by src/lib/config/env.ts.
# Supabase variables are required (Phase 2+).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (src/lib/config/env.server.ts). Never prefixed NEXT_PUBLIC_.
# Required for auth actions (password reset, sign-up consent) and the RLS/live tests.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 4 AI narration — optional; unset disables AI features.
AI_GATEWAY_API_KEY=

# Phase 7 Plaid bank connections (DECISIONS #43) — optional as a set; unset all
# to disable the Connected-institutions surface. Set all three or none.
# Dashboard credentials for the environment named by PLAID_ENV.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (default) | production
PLAID_ENV=sandbox
# AES-256-GCM key for stored access tokens: exactly 32 bytes, base64.
# Generate with: openssl rand -base64 32
PLAID_TOKEN_ENCRYPTION_KEY=
# Only during key rotation (scripts/rotate-plaid-key.mts); unset afterwards.
PLAID_TOKEN_ENCRYPTION_KEY_PREVIOUS=
# OAuth return page registered in the Plaid dashboard ("Allowed redirect URIs"). Exact match, no query.
# Production: https://pfi-one.vercel.app/plaid/oauth   Local sandbox: http://localhost:3000/plaid/oauth
PLAID_REDIRECT_URI=
# Per-user cap on active connected institutions (bounds Plaid's per-Item billing). Default 5.
PLAID_MAX_ITEMS=5
